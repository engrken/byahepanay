# Preferred: BIYAHEPANAY_DATABASE_URL. Existing Vercel Neon integration may still inject BYAHEPANAY_DATABASE_URL; local dev uses DATABASE_URL.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require
# Server-only HMAC secret (>=32 characters). Never expose as NEXT_PUBLIC_.
SPOTTER_SESSION_SECRET=replace-with-a-random-secret-of-at-least-32-characters
# Local development only; Production and Preview always enforce the 300 m geofence.
BYPASS_GEOFENCE=true

# Gmail SMTP email OTP. Use a Gmail/Google Workspace App Password, not the account password.
GMAIL_USER=your.account@gmail.com
GMAIL_APP_PASSWORD=your-16-character-google-app-password
# Local development toggle only. Production always requires email OTP for contributor writes.
REQUIRE_EMAIL_VERIFICATION=false

# Optional server-only allowlist for the developer administrator; the account must still complete email OTP.
DEVELOPER_ADMIN_EMAIL=developer@example.com
