# Public browser credentials (Supabase Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_OR_PUBLISHABLE_KEY

# Server-only. REQUIRED for validated write APIs; never prefix with NEXT_PUBLIC_.
# Keep this secret out of Git and never expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# true bypasses only the 300 m geofence so developers can test from home.
# Physics, route checks, consensus, and session rate limits remain active.
NEXT_PUBLIC_TEST_MODE=false
