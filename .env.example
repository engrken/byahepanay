# Vercel Marketplace injects BYAHEPANAY_DATABASE_URL; local dev uses a pooled Neon URL.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require
# Server-only HMAC secret (>=32 characters). Never expose as NEXT_PUBLIC_.
SPOTTER_SESSION_SECRET=replace-with-a-random-secret-of-at-least-32-characters
# Local development only; production and Preview always enforce the 300 m geofence.
BYPASS_GEOFENCE=true
