# Vercel Marketplace injects BYAHEPANAY_DATABASE_URL for this project.
# For local development, paste the pooled Neon connection string into DATABASE_URL.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# true bypasses only the 300 m geofence during controlled testing.
# Set to false before real public use.
NEXT_PUBLIC_TEST_MODE=true
